{
  "name": "gridmaterial-ui",
  "version": "1.1.0",
  "description": "Material-inspired responsive CSS and JavaScript UI framework with interactive components",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/server.js",
    "dev": "node scripts/server.js",
    "check": "node --check js/gridmaterial.js && node --check js/docs.js && node --check js/docs-data.js && node --check js/docs-variants.js && node --check scripts/build-css.js",
    "build:css": "node scripts/build-css.js",
    "prepack": "npm run build:css && npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "js/gridmaterial.js",
  "style": "css/gridmaterial.css",
  "files": [
    "css/",
    "js/",
    "assets/",
    "examples/",
    "scripts/",
    "index.html",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://dongannhien99-lgtm.github.io/grid-material/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongannhien99-lgtm/grid-material.git"
  },
  "bugs": {
    "url": "https://github.com/dongannhien99-lgtm/grid-material/issues"
  },
  "keywords": [
    "material-design",
    "css",
    "ui",
    "components",
    "vanilla-javascript",
    "responsive",
    "framework"
  ],
  "exports": {
    ".": {
      "require": "./js/gridmaterial.js",
      "default": "./js/gridmaterial.js"
    },
    "./css/gridmaterial.css": "./css/gridmaterial.css",
    "./css/*": "./css/*",
    "./js/*": "./js/*",
    "./assets/*": "./assets/*"
  }
}
